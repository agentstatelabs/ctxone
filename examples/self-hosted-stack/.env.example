# CtxOne self-hosted stack — environment config
#
# Copy to .env and edit before running `docker compose up`.
# Every value has a safe default in docker-compose.yml, so this file
# is mostly for overriding ports and secrets.

# -- Ports (host side) -----------------------------------------------------
HUB_PORT=3001
LENS_PORT=5173
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=8080
# THREADWEAVER_PORT=4000

# -- Lens client-side API URL ----------------------------------------------
# What the browser uses to reach the Hub. MUST be a URL you can hit from
# your laptop (not an in-network hostname), because Lens does its fetches
# client-side. If you're running behind a reverse proxy, set this to the
# public Hub URL, e.g. https://ctxone.example.com.
CTXONE_API_URL_PUBLIC=http://localhost:3001

# -- Hub logging ----------------------------------------------------------
# info = startup + one line per recall. debug = full request details.
RUST_LOG=info

# -- Open WebUI secret ----------------------------------------------------
# Replace with a long random string. `openssl rand -hex 32` is plenty.
WEBUI_SECRET_KEY=change-me-please-use-openssl-rand-hex-32
